# Copy this file to .env before running the server

PORT=5000

# JWT secret used to sign admin login tokens - change this to a long random string
JWT_SECRET=change-this-to-a-long-random-secret-string

# Default admin login (only used the FIRST time the server runs, to seed data/db.json)
# After first run, change the password from inside the Admin Panel -> Change Password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Comma separated list of origins allowed to call this API (your frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# --- Contact form email ---
# Required for the "Send message" button on the public Contact section to
# actually deliver mail. Easiest path: Gmail with an App Password (NOT your
# normal Gmail password):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste your Gmail address and the 16-character app password below.
# EMAIL_USER=youraddress@gmail.com
# EMAIL_PASS=your16charapppassword
EMAIL_USER=sreeniwasan14@gmail.com
EMAIL_PASS= lfasbdljxuitcgfy
# Optional: where contact messages are delivered. Defaults to EMAIL_USER.
# EMAIL_TO=sreeniwasan14@gmail.com

# Optional: use a different provider instead of Gmail by uncommenting these
# (leave EMAIL_USER/EMAIL_PASS as your SMTP username/password):
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
